#!/usr/bin/env bash

echo "-----> Found a .slugcleanup"

pwd
echo "${pwd}"

cd $1

pwd
echo "${pwd}"

# du -h --max-depth=2
# echo "-----"
# du -h --max-depth=2 | sort -hr
echo "-----"

du -h --max-depth=1 $(ls -A) | sort -hr

echo "-----"

du -hs $(ls -A) | sort -hr

echo "-----"

cat .slugcleanup

cat .slugcleanup | xargs -I {} bash -c 'rm -rf {}'
rm .slugcleanup
